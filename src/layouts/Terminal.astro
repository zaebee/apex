---
import StatusLine from "../components/StatusLine.astro";
import "../styles/terminal.css";

interface Props {
  title: string;
  description: string;
  current: "map" | "log" | "me";
}
const { title, description, current } = Astro.props;

// Canonical and Open Graph were missing entirely. Being found is the site's
// first stated goal, and a link shared into a chat or a feed currently renders
// as a bare URL with no title — the one place a stranger decides whether to
// click. No image: this page has nothing photographic to show, and inventing a
// card graphic would be decoration standing in for the thing itself.
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://zae.life").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0d0c" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="zae.life" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <!-- The RSS <link> returns with Task 10. Advertising a feed with nothing in
         it is a small false promise, and this site does not get to make those. -->
  </head>
  <body>
    <main class="term" id="term">
      <div class="wrap">
        <!-- The map lives in #stream and is never cleared. Command output goes
             to #output, so `clear` empties the transcript without deleting the
             server-rendered city — which used to leave `cd aura` answering
             "no district", a false statement about a district on the allowlist. -->
        <div id="stream"><slot /></div>
        <div id="output"></div>
        <div class="promptline" id="promptline">
          <span class="ps1">zae.life ~ $ </span><span class="typed" id="typed"></span><span
            class="cursor"></span><span class="hint" id="hint"
            >click anything, or type — cd &lt;district&gt; · log · me · help</span
          >
        </div>
        <!-- tabindex=-1: a 1x1 transparent input in the tab order makes focus
             vanish for a keyboard user. The command island focuses it
             programmatically; it never needs to be tab-reachable. -->
        <input
          id="sink"
          tabindex="-1"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          aria-label="terminal input"
        />
      </div>
    </main>
    <StatusLine current={current} />
    <script>
      import "../scripts/terminal.ts";
    </script>
  </body>
</html>
