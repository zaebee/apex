---
import type { District } from "../lib/districts";
import { continuationIndent, districtCells } from "../lib/format";
import { TONE } from "../lib/status";

interface Props {
  district: District;
}
const { district: d } = Astro.props;
const c = districtCells(d);

// <details> so the card opens by click and by keyboard with no JavaScript at
// all. The command layer sets `open` on this same element, which is why cd and
// a click cannot drift apart: one thing to change, one way to change it.
const link = d.host ? `https://${d.host}` : d.repo ? `https://github.com/${d.repo}` : null;

const label = (s: string) => `    ${s}${" ".repeat(Math.max(0, 10 - s.length))}`;
const unwritten = "‹ not written yet ›";

interface Line {
  label: string;
  value: string;
  cls: string;
}
const lines: Line[] = [];
if (d.repo) lines.push({ label: label("repo"), value: `github.com/${d.repo}`, cls: "" });
if (d.stats) {
  const unit = d.stats.activeDays === 1 ? "day" : "days";
  lines.push({
    label: label("built"),
    value: `${d.stats.commits} commits across ${d.stats.activeDays} active ${unit}, last ${d.stats.last}`,
    cls: "",
  });
}
for (const [k, v] of [
  ["what", d.what],
  ["why", d.why],
  ["learned", d.learned],
] as const) {
  lines.push({ label: label(k), value: v ?? unwritten, cls: v ? "" : "warn" });
}

const NL = "\n";
const footer = "    why and learned come from districts.toml — your words, never generated.";
---

<!-- data-act sits on the summary, not the details: with it on the details, every
     click inside the open card — prose, the outbound link, an attempted text
     selection — resolved to a cd toggle and was preventDefault()ed, so the card
     fought the reader and its one link could never be followed. -->
<details class="district" id={d.id}>
  <summary class="row" data-act="cd" data-id={d.id}><span class={TONE[d.status]}>{c.mark}</span>{c.id}<span class="dim host-col">{c.host}</span><span class={TONE[d.status]}>{c.reply}</span><span class="dim">{c.stats}{c.last}</span>{d.status === "alive" && d.what ? <span class="dim what">{`\n${" ".repeat(continuationIndent(d))}${d.what}`}</span> : null}</summary>

  <div class="card">
    <pre class="prose">{lines.map((l) => <Fragment><span class="dim">{l.label}</span><span class={l.cls}>{l.value}</span>{NL}</Fragment>)}</pre>
    {link && <pre class="prose"><span class="dim">{label("open")}</span><a href={link} rel="noopener">{link}</a></pre>}
    <pre class="prose"><span class="dim">{footer}</span></pre>
  </div>
</details>
