---
import type { District } from "../lib/districts";
import { continuationIndent, districtCells, districtLink, districtSpoken, evidenceGroups, secondLineFor } from "../lib/format";
import { type HealthSnapshot, TONE } from "../lib/status";

interface Props {
  district: District;
  /** The whole snapshot, not its timestamp. A timestamp cannot say whether the
   *  check succeeded or whether it reached this host, and the observed group
   *  must not claim an observation on either. */
  health: HealthSnapshot | null;
}
const { district: d, health } = Astro.props;
const c = districtCells(d);

// One second line, whichever is the more useful thing to know about this
// district: what a living one is, or how long a silent one has been silent.
// They never compete — a district is one or the other.
const secondLine = secondLineFor(d);

// <details> so the card opens by click and by keyboard with no JavaScript at
// all. The command layer sets `open` on this same element, which is why cd and
// a click cannot drift apart: one thing to change, one way to change it.
const link = districtLink(d);

// The columns are a layout. Announced, they are "black circle, aura, aura dot
// zae dot life, 517c slash 41d, aug apostrophe 26" — the padding is decoration
// that means something only to the eye. Both forms come from the one district
// so the page cannot say something it does not show.
const spoken = districtSpoken(d);

// Four groups, each naming the file it came from. The card used to show one
// flat list in one voice, which said nothing about how any of it was known.
const groups = evidenceGroups(d, health);

const label = (s: string) => `      ${s}${" ".repeat(Math.max(0, 10 - s.length))}`;

const NL = "\n";
---

<!-- data-act sits on the summary, not the details: with it on the details, every
     click inside the open card — prose, the outbound link, an attempted text
     selection — resolved to a cd toggle and was preventDefault()ed, so the card
     fought the reader and its one link could never be followed. -->
<details class="district" id={d.id}>
  <summary class="row" data-act="cd" data-id={d.id}><span aria-hidden="true"><span class={TONE[d.status]}>{c.mark}</span>{c.id}<span class="dim host-col">{c.host}</span><span class={TONE[d.status]}>{c.reply}</span><span class="dim">{c.stats}{c.last}</span>{secondLine ? <span class="dim what">{`\n${" ".repeat(continuationIndent(d))}${secondLine}`}</span> : null}</span><span class="visually-hidden">{spoken}</span></summary>

  <div class="card">
    <div class="evidence" data-evidence={d.id}>
      {groups.map((g) => (
        <pre class="prose"><span class="kind">{`    ${g.kind}${" ".repeat(Math.max(1, 12 - g.kind.length))}`}</span><span class={g.unrecorded ? "warn" : "dim"}>{g.source}{g.freshness ? ` · ${g.freshness}` : ""}</span>{NL}{g.lines.map((l) => <Fragment><span class="dim">{label(l.label)}</span><span class={l.unwritten ? "warn" : ""}>{l.value}</span>{NL}</Fragment>)}</pre>
      ))}
    </div>
    {link && <pre class="prose"><span class="dim">{"    open        "}</span><a href={link} rel="noopener">{link}</a></pre>}
  </div>
</details>
