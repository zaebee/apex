---
import type { District } from "../lib/districts";
import { continuationIndent, districtCells, districtLink, observedFor } from "../lib/format";
import { freshness } from "../lib/freshness";
import { TONE } from "../lib/status";

interface Props {
  district: District;
}
const { district: d } = Astro.props;
const c = districtCells(d);

// One second line, whichever is the more useful thing to know about this
// district: what a living one is, or how long a silent one has been silent.
// They never compete — a district is one or the other.
const watched = observedFor(d);
const secondLine = d.status === "alive" ? (d.what ?? watched) : watched;

// <details> so the card opens by click and by keyboard with no JavaScript at
// all. The command layer sets `open` on this same element, which is why cd and
// a click cannot drift apart: one thing to change, one way to change it.
const link = districtLink(d);

const label = (s: string) => `    ${s}${" ".repeat(Math.max(0, 10 - s.length))}`;
const unwritten = "‹ not written yet ›";

interface Line {
  label: string;
  value: string;
  cls: string;
}
const lines: Line[] = [];
if (d.repo) lines.push({ label: label("repo"), value: `github.com/${d.repo}`, cls: "" });
if (d.stats) {
  const unit = d.stats.activeDays === 1 ? "day" : "days";
  lines.push({
    label: label("built"),
    value: `${d.stats.commits} commits across ${d.stats.activeDays} active ${unit}, last ${d.stats.last}`,
    cls: "",
  });
  // Never "stale". Git history does not erode the way a health probe does — a
  // count read last week is still a true account of commits that happened — so
  // the card says when it was read and stops there.
  const read = freshness(d.stats.readAt ?? null, new Date());
  lines.push({
    label: label("read"),
    value: read.label === "never" ? "not recorded" : read.label,
    cls: read.label === "never" ? "warn" : "dim",
  });
}
for (const [k, v] of [
  ["what", d.what],
  ["why", d.why],
  ["learned", d.learned],
] as const) {
  lines.push({ label: label(k), value: v ?? unwritten, cls: v ? "" : "warn" });
}
if (watched) lines.push({ label: label("watched"), value: watched, cls: "" });

const NL = "\n";
const footer = "    why and learned come from districts.toml — your words, never generated.";
---

<!-- data-act sits on the summary, not the details: with it on the details, every
     click inside the open card — prose, the outbound link, an attempted text
     selection — resolved to a cd toggle and was preventDefault()ed, so the card
     fought the reader and its one link could never be followed. -->
<details class="district" id={d.id}>
  <summary class="row" data-act="cd" data-id={d.id}><span class={TONE[d.status]}>{c.mark}</span>{c.id}<span class="dim host-col">{c.host}</span><span class={TONE[d.status]}>{c.reply}</span><span class="dim">{c.stats}{c.last}</span>{secondLine ? <span class="dim what">{`\n${" ".repeat(continuationIndent(d))}${secondLine}`}</span> : null}</summary>

  <div class="card">
    <pre class="prose">{lines.map((l) => <Fragment><span class="dim">{l.label}</span><span class={l.cls}>{l.value}</span>{NL}</Fragment>)}</pre>
    {link && <pre class="prose"><span class="dim">{label("open")}</span><a href={link} rel="noopener">{link}</a></pre>}
    <pre class="prose"><span class="dim">{footer}</span></pre>
  </div>
</details>
